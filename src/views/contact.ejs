<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact Us - ANSADEIS</title>
  
  <link rel="stylesheet" href="/css/output.css">
  <link rel="stylesheet" href="https://cloudflare.com">
</head>
<body class="bg-gray-50 font-sans tracking-wide antialiased">

  <!-- Navbar (Matched perfectly with other sections) -->
  <nav class="bg-white/95 backdrop-blur-md shadow-sm sticky top-0 z-50 border-b border-gray-100">
    <div class="max-w-[90rem] mx-auto px-6 py-4">
      <div class="grid grid-cols-2 md:grid-cols-3 items-center">
        
        <!-- Left Section: Logo -->
        <div class="flex justify-start">
          <a href="/" class="flex items-center">
            <img src="https://diiqzqswkdivdyjvabpm.supabase.co/storage/v1/object/public/Room%20Images/IMG_0176.PNG" alt="ANSADEIS" class="h-10 md:h-12 w-auto object-contain">
          </a>
        </div>

        <!-- Middle Section: Centered Nav Links -->
        <div class="hidden md:flex justify-center space-x-10 text-base font-medium text-gray-700 tracking-wider uppercase">
          <a href="/" class="hover:text-rose-600 transition-colors pb-1 border-b-2 border-transparent hover:border-rose-600">Home</a>
          <a href="/rooms" class="hover:text-rose-600 transition-colors pb-1 border-b-2 border-transparent hover:border-rose-600">Rooms & Suites</a>
          <a href="/about" class="hover:text-rose-600 transition-colors pb-1 border-b-2 border-transparent hover:border-rose-600">About Us</a>
          <a href="/contact" class="text-rose-600 transition-colors border-b-2 border-rose-600 pb-1">Contact</a>
        </div>

        <!-- Right Section: Button -->
        <div class="flex justify-end items-center gap-4">
          <a href="<%= airbnbUrl %>" target="_blank" 
             class="hidden md:inline-flex bg-rose-600 hover:bg-rose-700 text-white px-7 py-2.5 rounded-full text-sm font-semibold tracking-wide uppercase transition-all shadow-sm hover:shadow-rose-200 hover:-translate-y-0.5 transform duration-200">
            Book on Airbnb →
          </a>

          <button id="mobile-menu-button" class="md:hidden text-2xl text-gray-800 p-1 focus:outline-none">
            <i class="fa-solid fa-bars"></i>
          </button>
        </div>
      </div>

      <!-- Mobile Menu -->
      <div id="mobile-menu" class="hidden md:hidden mt-4 py-4 border-t border-gray-100">
        <div class="flex flex-col space-y-4 text-center font-medium tracking-wider uppercase">
          <a href="/" class="text-gray-700 hover:text-rose-600 py-2">Home</a>
          <a href="/rooms" class="text-gray-700 hover:text-rose-600 py-2">Rooms & Suites</a>
          <a href="/about" class="text-gray-700 hover:text-rose-600 py-2">About Us</a>
          <a href="/contact" class="text-rose-600 py-2">Contact</a>
          <a href="<%= airbnbUrl %>" target="_blank" class="mt-4 bg-rose-600 text-white py-3.5 rounded-xl block text-sm font-bold shadow-md">
            Book on Airbnb →
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Header Banner -->
  <header class="py-16 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-6 text-center space-y-3">
      <span class="text-rose-600 uppercase tracking-widest font-semibold text-sm">Get In Touch</span>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900">Contact Our Team</h1>
      <div class="h-1 w-12 bg-rose-600 mx-auto rounded-full"></div>
    </div>
  </header>

  <!-- Contact Grid Wrapper -->
  <main class="max-w-7xl mx-auto px-6 py-20">
    <div class="grid lg:grid-cols-3 gap-12 items-start">
      
      <!-- Left 1-Column: Quick Contact Cards -->
      <div class="space-y-6 lg:col-span-1">
        
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex items-start gap-4">
          <div class="w-12 h-12 bg-rose-50 text-rose-600 rounded-xl flex items-center justify-center text-lg shrink-0">
            <i class="fa-solid fa-location-dot"></i>
          </div>
          <div>
            <h3 class="font-bold text-gray-900 mb-1">Our Location</h3>
            <p class="text-gray-600 text-sm leading-relaxed">Lingayen, Pangasinan,<br>Philippines</p>
          </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex items-start gap-4">
          <div class="w-12 h-12 bg-rose-50 text-rose-600 rounded-xl flex items-center justify-center text-lg shrink-0">
            <i class="fa-solid fa-envelope"></i>
          </div>
          <div>
            <h3 class="font-bold text-gray-900 mb-1">Email Us</h3>
            <p class="text-gray-600 text-sm font-medium hover:text-rose-600 transition-colors">stay@ansadeis.com</p>
          </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex items-start gap-4">
          <div class="w-12 h-12 bg-rose-50 text-rose-600 rounded-xl flex items-center justify-center text-lg shrink-0">
            <i class="fa-solid fa-phone"></i>
          </div>
          <div>
            <h3 class="font-bold text-gray-900 mb-1">Call Details</h3>
            <p class="text-gray-600 text-sm font-medium">+63 (000) 000-0000</p>
          </div>
        </div>

      </div>

      <!-- Right 2-Columns: Message Submission Form -->
      <div class="bg-white p-8 md:p-10 rounded-3xl border border-gray-100 shadow-sm lg:col-span-2">
        <h2 class="text-2xl font-bold text-gray-900 mb-2">Send Us A Message</h2>
        <p class="text-gray-600 mb-8">Have specific booking questions or property event inquiries? Fill out the structure below.</p>
        
        <form action="/contact" method="POST" class="space-y-6">
          <div class="grid md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label class="text-xs font-bold uppercase tracking-wider text-gray-700">Full Name</label>
              <input type="text" name="name" required placeholder="John Doe" 
                     class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3.5 text-sm text-gray-900 focus:outline-none focus:border-rose-500 focus:bg-white transition-all">
            </div>
            <div class="space-y-2">
              <label class="text-xs font-bold uppercase tracking-wider text-gray-700">Email Address</label>
              <input type="email" name="email" required placeholder="john@example.com" 
                     class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3.5 text-sm text-gray-900 focus:outline-none focus:border-rose-500 focus:bg-white transition-all">
            </div>
          </div>

          <div class="space-y-2">
            <label class="text-xs font-bold uppercase tracking-wider text-gray-700">Subject</label>
            <input type="text" name="subject" required placeholder="Inquiry about reservation dates" 
                   class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3.5 text-sm text-gray-900 focus:outline-none focus:border-rose-500 focus:bg-white transition-all">
          </div>

          <div class="space-y-2">
            <label class="text-xs font-bold uppercase tracking-wider text-gray-700">Your Message</label>
            <textarea name="message" rows="5" required placeholder="Tell us how we can accommodate you..." 
                      class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3.5 text-sm text-gray-900 focus:outline-none focus:border-rose-500 focus:bg-white transition-all resize-none"></textarea>
          </div>

          <button type="submit" 
                  class="w-full bg-rose-600 hover:bg-rose-700 text-white font-bold uppercase tracking-wider text-sm py-4 rounded-xl transition-all shadow-md hover:shadow-rose-100">
            Submit Inquiry
          </button>
        </form>
      </div>

    </div>
  </main>

  <script>
    // Mobile Menu Toggle
    const menuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    
    if (menuButton && mobileMenu) {
      menuButton.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
        const icon = menuButton.querySelector('i');
        icon.classList.toggle('fa-bars');
        icon.classList.toggle('fa-xmark');
      });
    }
  </script>
</body>
</html>
