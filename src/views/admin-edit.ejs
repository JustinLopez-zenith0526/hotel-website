<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Room - ANSADEIS</title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-gray-100 font-sans antialiased tracking-wide">

  <header class="bg-gray-900 text-white px-8 py-5 flex justify-between items-center shadow-md">
    <div class="flex items-center gap-3">
      <span class="bg-blue-600 text-xs uppercase font-black tracking-widest px-2.5 py-1 rounded">Editor Engine</span>
      <h1 class="text-xl font-bold tracking-tight">Modify Room Properties</h1>
    </div>
    <a href="/admin" class="text-sm text-gray-400 hover:text-white transition-colors">← Back to Dashboard</a>
  </header>

  <main class="max-w-2xl mx-auto px-6 py-12">
    <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-200">
      <h2 class="text-2xl font-bold text-gray-900 mb-2">Editing: <%= room.name %></h2>
      <p class="text-xs text-gray-500 mb-6">Updating this form will overwrite the records inside your Supabase table.</p>

      <form action="/admin/rooms/<%= room.id %>/edit" method="POST" class="space-y-4">
        <div class="space-y-1.5">
          <label class="text-xs font-bold uppercase tracking-wider text-gray-700">Display Name</label>
          <input type="text" name="name" value="<%= room.name %>" required class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-rose-500 focus:bg-white transition-all">
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label class="text-xs font-bold uppercase tracking-wider text-gray-700">Price (PHP)</label>
            <input type="number" name="price" value="<%= room.price %>" required class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-rose-500 focus:bg-white transition-all">
          </div>
          <div class="space-y-1.5">
            <label class="text-xs font-bold uppercase tracking-wider text-gray-700">Tracking ID</label>
            <input type="text" name="roomType" value="<%= room.roomType %>" required class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-rose-500 focus:bg-white transition-all">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label class="text-xs font-bold uppercase tracking-wider text-gray-700">Beds</label>
            <input type="text" name="bedType" value="<%= room.bedType %>" required class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-rose-500 focus:bg-white transition-all">
          </div>
          <div class="space-y-1.5">
            <label class="text-xs font-bold uppercase tracking-wider text-gray-700">View / Balcony</label>
            <input type="text" name="viewType" value="<%= room.viewType %>" required class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-rose-500 focus:bg-white transition-all">
          </div>
        </div>

        <div class="space-y-1.5">
          <label class="text-xs font-bold uppercase tracking-wider text-gray-700">Photo URL</label>
          <input type="url" name="imageUrl" value="<%= room.imageUrl %>" required class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-rose-500 focus:bg-white transition-all">
        </div>

        <div class="space-y-1.5">
          <label class="text-xs font-bold uppercase tracking-wider text-gray-700">Airbnb Link</label>
          <input type="url" name="airbnbUrl" value="<%= room.airbnbUrl %>" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-rose-500 focus:bg-white transition-all">
        </div>

        <div class="pt-4 flex gap-4">
          <a href="/admin" class="w-1/3 text-center bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold uppercase tracking-wider text-xs py-4 rounded-xl transition-all">
            Cancel
          </a>
          <button type="submit" class="w-2/3 bg-blue-600 hover:bg-blue-700 text-white font-bold uppercase tracking-wider text-xs py-4 rounded-xl transition-all shadow-md">
            Save Structural Changes
          </button>
        </div>
      </form>
    </div>
  </main>

</body>
</html>
