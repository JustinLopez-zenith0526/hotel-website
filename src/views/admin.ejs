<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PMS Core Admin - ANSADEIS</title>
  <link rel="stylesheet" href="/css/output.css">
  <link rel="stylesheet" href="https://cloudflare.com">
</head>
<body class="bg-gray-100 font-sans antialiased tracking-wide relative">

  <header class="bg-gray-900 text-white px-8 py-5 flex justify-between items-center shadow-md">
    <div class="flex items-center gap-3">
      <span class="bg-rose-600 text-xs uppercase font-black tracking-widest px-2.5 py-1 rounded">PMS Engine v2.5</span>
      <h1 class="text-xl font-bold tracking-tight">ANSADEIS Control Center</h1>
    </div>
    <a href="/rooms" target="_blank" class="text-sm text-gray-400 hover:text-white transition-colors">
      Live View <i class="fa-solid fa-arrow-up-right-from-square ml-1 text-xs"></i>
    </a>
  </header>

  <main class="max-w-[95rem] mx-auto px-6 py-12 grid lg:grid-cols-3 gap-10">
        <!-- REAL-TIME PMS REVENUE & OPERATIONS COUNTERS ANALYTICS -->
    <div class="lg:col-span-3 grid grid-cols-1 md:grid-cols-3 gap-6 mb-4">
      <!-- Card 1: Gross Financial Intake -->
      <div class="bg-gradient-to-br from-gray-900 to-gray-800 text-white p-6 rounded-2xl shadow-sm border border-gray-800 flex items-center justify-between">
        <div>
          <p class="text-xs font-black uppercase tracking-wider text-gray-400">Gross Total Revenue</p>
          <h3 class="text-3xl font-black mt-2 text-emerald-400">₱<%= metrics.revenue.toLocaleString() %></h3>
        </div>
        <div class="text-3xl opacity-20"><i class="fa-solid fa-wallet"></i></div>
      </div>

      <!-- Card 2: Active Guest Checkins -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200/60 flex items-center justify-between">
        <div>
          <p class="text-xs font-black uppercase tracking-wider text-gray-500">Live Occupancy Load</p>
          <h3 class="text-3xl font-black text-gray-900 mt-2"><%= metrics.occupancy %> <span class="text-sm font-medium text-gray-400">Active Stays</span></h3>
        </div>
        <div class="text-3xl text-rose-500/20"><i class="fa-solid fa-user-check"></i></div>
      </div>

      <!-- Card 3: Dirty Rooms Queue -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200/60 flex items-center justify-between">
        <div>
          <p class="text-xs font-black uppercase tracking-wider text-gray-500">Housekeeping Load</p>
          <h3 class="text-3xl font-black text-gray-900 mt-2"><%= metrics.cleaning %> <span class="text-sm font-medium text-gray-400">Dirty Rooms</span></h3>
        </div>
        <div class="text-3xl text-red-500/20"><i class="fa-solid fa-broom"></i></div>
      </div>
    </div>

    <!-- LEFT PANEL: Create Form -->
    <section class="bg-white p-8 rounded-2xl shadow-sm border border-gray-200 lg:col-span-1 h-fit">
      <h2 class="text-xl font-bold text-gray-900 mb-2">Create New Listing</h2>
      <p class="text-xs text-gray-500 mb-6">Initialize a new hotel suite room listing straight into your database.</p>

      <form action="/admin/rooms" method="POST" class="space-y-4">
        <div class="space-y-1.5">
          <label class="text-xs font-bold uppercase tracking-wider text-gray-700">Display Name</label>
          <input type="text" name="name" required placeholder="e.g., Garden Suite" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-rose-500 focus:bg-white transition-all">
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label class="text-xs font-bold uppercase tracking-wider text-gray-700">Price (PHP)</label>
            <input type="number" name="price" required placeholder="3500" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-rose-500 focus:bg-white transition-all">
          </div>
          <div class="space-y-1.5">
            <label class="text-xs font-bold uppercase tracking-wider text-gray-700">Room ID</label>
            <input type="text" name="roomType" required placeholder="Room 1" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-rose-500 focus:bg-white transition-all">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label class="text-xs font-bold uppercase tracking-wider text-gray-700">Beds</label>
            <input type="text" name="bedType" required placeholder="King bed" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-rose-500 focus:bg-white transition-all">
          </div>
          <div class="space-y-1.5">
            <label class="text-xs font-bold uppercase tracking-wider text-gray-700">View / Balcony</label>
            <input type="text" name="viewType" required placeholder="City View" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-rose-500 focus:bg-white transition-all">
          </div>
        </div>

        <div class="space-y-1.5">
          <label class="text-xs font-bold uppercase tracking-wider text-gray-700">Initial Status Availability</label>
          <select name="status" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-rose-500 focus:bg-white transition-all">
            <option value="Available">Available</option>
            <option value="Booked">Booked (Blocked)</option>
            <option value="Maintenance">Maintenance</option>
          </select>
        </div>

        <div class="space-y-1.5">
          <label class="text-xs font-bold uppercase tracking-wider text-gray-700">Photo URL</label>
          <input type="url" name="imageUrl" required placeholder="https://unsplash.com..." class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-rose-500 focus:bg-white transition-all">
        </div>

        <div class="space-y-1.5">
          <label class="text-xs font-bold uppercase tracking-wider text-gray-700">Airbnb Redirect URL</label>
          <input type="url" name="airbnbUrl" placeholder="https://airbnb.com..." class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-rose-500 focus:bg-white transition-all">
        </div>

        <button type="submit" class="w-full bg-rose-600 hover:bg-rose-700 text-white font-bold uppercase tracking-wider text-xs py-4 rounded-xl transition-all shadow-md font-semibold">
          Save Room to Cloud
        </button>
      </form>
    </section>

<!-- RIGHT PANEL: Live Inventory CRUD Grid -->
    <section class="bg-white p-8 rounded-2xl shadow-sm border border-gray-200 lg:col-span-2">
      <h2 class="text-xl font-bold text-gray-900 mb-2">Active Catalog & Operations</h2>
      <p class="text-xs text-gray-500 mb-6">Modify live availability statuses, update specifics, or purge listings instantly.</p>

      <div class="overflow-x-auto rounded-xl border border-gray-100">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-gray-50 text-gray-500 text-xs font-bold uppercase tracking-wider border-b border-gray-100">
              <th class="p-4">Listing details</th>
              <th class="p-4">Tracking ID</th>
              <th class="p-4">Live Status</th>
              <th class="p-4 text-center">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50 font-medium text-gray-700">
            <% if (rooms && rooms.length > 0) { %>
              <% rooms.forEach(room => { %>
                <tr class="hover:bg-gray-50/50 transition-colors">
                  <td class="p-4 flex items-center gap-3">
                    <img src="<%= room.imageUrl %>" class="w-12 h-12 object-cover rounded-lg bg-gray-100 shadow-inner" alt="">
                    <div>
                      <p class="font-bold text-gray-900"><%= room.name %></p>
                      <p class="text-xs font-bold text-rose-600">₱<%= room.price.toLocaleString() %></p>
                    </div>
                  </td>
                  
                  <td class="p-4">
                    <span class="bg-gray-100 text-gray-800 px-2.5 py-1 rounded-md text-xs font-semibold"><%= room.roomType %></span>
                  </td>
                  
                  <td class="p-4">
                    <form action="/admin/rooms/<%= room.id %>/status" method="POST" onchange="this.submit()">
                      <select name="status" class="text-xs font-bold border rounded-lg px-2.5 py-1.5 focus:outline-none cursor-pointer
                        <% if(room.status === 'Available') { %> border-emerald-200 bg-emerald-50 text-emerald-700 <% } %>
                        <% if(room.status === 'Booked') { %> border-amber-200 bg-amber-50 text-amber-700 <% } %>
                        <% if(room.status === 'Maintenance') { %> border-red-200 bg-red-50 text-red-700 <% } %>">
                        <option value="Available" <%= room.status === 'Available' ? 'selected' : '' %>>🟢 Available</option>
                        <option value="Booked" <%= room.status === 'Booked' ? 'selected' : '' %>>🟡 Booked</option>
                        <option value="Maintenance" <%= room.status === 'Maintenance' ? 'selected' : '' %>>🔴 Maintenance</option>
                      </select>
                    </form>
                  </td>

                  <!-- ACTION ACTIONS (EDIT & DELETE BUTTONS - FIXED WITH DATASETS) -->
                  <td class="p-4 text-center space-x-3 whitespace-nowrap" style="text-align: center; white-space: nowrap;">

                    <!-- Native anchor link avoids JavaScript click freezes entirely -->
                    <a href="/admin/rooms/<%= room.id %>/edit" 
                       style="display: inline-flex; align-items: center; justify-content: center; text-decoration: none; gap: 4px; background-color: #eff6ff; border: 1px solid #bfdbfe; color: #1d4ed8; padding: 6px 12px; border-radius: 8px; font-size: 12px; font-weight: 700; cursor: pointer; margin-right: 8px;">
                        Edit
                    </a>
                    

                    <form action="/admin/rooms/<%= room.id %>/delete" method="POST" onsubmit="return confirm('Permanently delete this listing?')" class="inline-block" style="display: inline-block; margin: 0;">
                      <button type="submit" 
                                class="inline-flex items-center gap-1 bg-red-50 border border-red-200 text-red-600 hover:bg-red-600 hover:text-white px-3 py-1.5 rounded-lg text-xs font-bold transition-all shadow-sm"
                                style="display: inline-flex; align-items: center; justify-content: center; gap: 4px; background-color: #fef2f2; border: 1px solid #fecaca; color: #dc2626; padding: 6px 12px; border-radius: 8px; font-size: 12px; font-weight: 700; cursor: pointer;">
                            Delete
                      </button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="4" class="p-8 text-center text-gray-400">Inventory is completely empty.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  </main>
        <!-- SEPARATED BOOKINGS WRAPPER PANEL -->
    <div class="lg:col-span-3 space-y-10 mt-6">
      
      <!-- TABLE 1: INCOMING RESERVATION REQUESTS (PENDING ONLY) -->
      <section class="bg-white p-8 rounded-2xl shadow-sm border border-gray-200/60">
        <div class="mb-6">
          <h2 class="text-xl font-bold text-gray-900">⏳ Incoming Reservation Requests</h2>
          <p class="text-xs text-gray-500 mt-0.5">Approve incoming guest submissions to officially lock calendars.</p>
        </div>

        <div class="overflow-x-auto rounded-xl border border-gray-100">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-gray-50 text-gray-500 text-xs font-bold uppercase tracking-wider border-b border-gray-100">
                <th class="p-4">Guest Details</th>
                <th class="p-4">Unit</th>
                <th class="p-4">Calendar Dates</th>
                <th class="p-4">Gross Revenue</th>
                <th class="p-4">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-50 font-medium text-gray-700">
              <% let pendingCount = 0; %>
              <% if (typeof bookings !== 'undefined' && bookings && bookings.length > 0) { %>
                <% bookings.forEach(booking => { %>
                  <% if (booking.status === 'Pending') { pendingCount++; %>
                    <tr class="hover:bg-gray-50/50 transition-colors">
                      <td class="p-4">
                        <p class="font-bold text-gray-900"><%= booking.guestName %></p>
                        <p class="text-xs text-gray-400 font-normal"><%= booking.guestEmail %> • <%= booking.guestPhone %></p>
                        <p class="text-[11px] text-rose-500 font-semibold mt-1">
                          Requested: <%= new Date(booking.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                        </p>
                      </td>
                      <td class="p-4">
                        <span class="bg-gray-100 text-gray-800 px-2.5 py-1 rounded-md text-xs font-semibold"><%= booking.room ? booking.room.roomType : 'Unknown Unit' %></span>
                      </td>
                      
                      <td class="p-4 text-xs text-gray-600">
                        <p><strong>In:</strong> <%= new Date(booking.checkIn).toLocaleDateString() %></p>
                        <p><strong>Out:</strong> <%= new Date(booking.checkOut).toLocaleDateString() %></p>
                      </td>
                      <td class="p-4 font-extrabold text-emerald-600">₱<%= booking.totalPrice.toLocaleString() %></td>
                      <td class="p-4">
                        <form action="/admin/bookings/<%= booking.id %>/status" method="POST" onchange="this.submit()">
                          <select name="status" class="text-xs font-bold border rounded-lg px-2.5 py-1.5 border-amber-200 bg-amber-50 text-amber-700 cursor-pointer focus:outline-none">
                            <option value="Pending" selected>⏳ Pending</option>
                            <option value="Approved">✅ Approve Stay</option>
                            <option value="Cancelled">❌ Decline Inquiry</option>
                          </select>
                        </form>
                      </td>
                    </tr>
                  <% } %>
                <% }); %>
              <% } %>
              <% if (pendingCount === 0) { %>
                <tr>
                  <td colspan="5" class="p-8 text-center text-gray-400 font-normal">No pending reservation requests right now.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>

      <!-- TABLE 2: ACTIVE & PAST RESERVATION HISTORIES (APPROVED, COMPLETED, CANCELLED) -->
      <section class="bg-white p-8 rounded-2xl shadow-sm border border-gray-200/60">
        <div class="mb-6">
          <h2 class="text-xl font-bold text-gray-900">📋 Active Stays & Transaction Ledger</h2>
          <p class="text-xs text-gray-500 mt-0.5">Tracks running hotel occupancy metrics and past historical logs.</p>
        </div>

        <div class="overflow-x-auto rounded-xl border border-gray-100">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-gray-50 text-gray-500 text-xs font-bold uppercase tracking-wider border-b border-gray-100">
                <th class="p-4">Guest Details</th>
                <th class="p-4">Unit</th>
                <th class="p-4">Calendar Dates</th>
                <th class="p-4">Gross Revenue</th>
                <th class="p-4 text-center">Operational Status / Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-50 font-medium text-gray-700">
              <% let historyCount = 0; %>
              <% if (typeof bookings !== 'undefined' && bookings && bookings.length > 0) { %>
                <% bookings.forEach(booking => { %>
                  <% if (booking.status !== 'Pending') { historyCount++; %>
                    <tr class="hover:bg-gray-50/50 transition-colors">
                      <td class="p-4">
                        <p class="font-bold text-gray-900"><%= booking.guestName %></p>
                        <p class="text-xs text-gray-400 font-normal"><%= booking.guestEmail %> • <%= booking.guestPhone %></p>
                      </td>
                      <td class="p-4">
                        <span class="bg-gray-100 text-gray-800 px-2.5 py-1 rounded-md text-xs font-semibold"><%= booking.room ? booking.room.roomType : 'Unknown Unit' %></span>
                      </td>
                      <td class="p-4 text-xs text-gray-600">
                        <p><strong>In:</strong> <%= new Date(booking.checkIn).toLocaleDateString() %></p>
                        <p><strong>Out:</strong> <%= new Date(booking.checkOut).toLocaleDateString() %></p>
                      </td>
                      <td class="p-4 font-extrabold text-emerald-600">₱<%= booking.totalPrice.toLocaleString() %></td>
                      <td class="p-4 text-center whitespace-nowrap">
                        
                        <% if (booking.status === 'Approved') { %>
                          <!-- Active stay layout action blocks stay exactly the same... -->
                          <div class="inline-flex items-center gap-3">
                            <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 px-3 py-1.5 rounded-lg text-xs font-bold">🟢 Active Stay</span>
                            <form action="/admin/bookings/<%= booking.id %>/checkout" method="POST" onsubmit="return confirm('Process instant check-out for this guest? Room will rotate into Maintenance.')" style="display: inline-block; margin: 0;">
                              <button type="submit" style="display: inline-flex; align-items: center; justify-content: center; background-color: #374151; border: none; color: #ffffff; padding: 6px 12px; border-radius: 8px; font-size: 11px; font-weight: 700; cursor: pointer;">⚡ Checkout Now</button>
                            </form>
                          </div>
                        <% } else if (booking.status === 'Completed') { %>
                          <!-- UPGRADED WITH DELETE PURGE CAPABILITY FOR COMPLETED LOGS -->
                          <div class="inline-flex items-center gap-4">
                            <span class="bg-blue-50 text-blue-700 border border-blue-100 px-3 py-1 rounded-lg text-xs font-bold">🏁 Checked Out</span>
                            <form action="/admin/bookings/<%= booking.id %>/delete" method="POST" onsubmit="return confirm('Wipe this completed test transaction row forever?')" style="display: inline-block; margin: 0;">
                              <button type="submit" style="background: none; border: none; color: #9ca3af; font-size: 13px; cursor: pointer;" class="hover:text-red-600 transition-colors">🗑️ Clear</button>
                            </form>
                          </div>
                        <% } else if (booking.status === 'Cancelled') { %>
                          <!-- UPGRADED WITH DELETE PURGE CAPABILITY FOR CANCELLED LOGS -->
                          <div class="inline-flex items-center gap-4">
                            <span class="bg-red-50 text-red-600 border border-red-100 px-3 py-1 rounded-lg text-xs font-bold">❌ Cancelled</span>
                            <form action="/admin/bookings/<%= booking.id %>/delete" method="POST" onsubmit="return confirm('Permanently remove this cancelled test inquiry log?')" style="display: inline-block; margin: 0;">
                              <button type="submit" style="background: none; border: none; color: #9ca3af; font-size: 13px; cursor: pointer;" class="hover:text-red-600 transition-colors">🗑️ Clear</button>
                            </form>
                          </div>
                        <% } %>


                      </td>
                    </tr>
                  <% } %>
                <% }); %>
              <% } %>
              <% if (historyCount === 0) { %>
                <tr>
                  <td colspan="5" class="p-8 text-center text-gray-400 font-normal">No past operational histories found.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>

    </div>
