<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rooms & Suites - ANSADEIS</title>
  
  <link rel="stylesheet" href="/css/output.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body class="bg-gray-50 font-sans tracking-wide antialiased">

  <!-- Navbar (Matched perfectly with Home Section) -->
  <nav class="bg-white/95 backdrop-blur-md shadow-sm sticky top-0 z-50 border-b border-gray-100">
    <div class="max-w-[90rem] mx-auto px-6 py-4">
      <div class="grid grid-cols-2 md:grid-cols-3 items-center">
        
        <!-- Left Section: Logo -->
        <div class="flex justify-start">
          <a href="/" class="flex items-center">
            <img src="/images/logo.png" alt="ANSADEIS" class="h-10 md:h-12 w-auto object-contain">
          </a>
        </div>

        <!-- Middle Section: Centered Nav Links -->
        <div class="hidden md:flex justify-center space-x-10 text-base font-medium text-gray-700 tracking-wider uppercase">
          <a href="/" class="hover:text-rose-600 transition-colors pb-1 border-b-2 border-transparent hover:border-rose-600">Home</a>
          <a href="/rooms" class="text-rose-600 transition-colors border-b-2 border-rose-600 pb-1">Rooms & Suites</a>
          <a href="/about" class="hover:text-rose-600 transition-colors pb-1 border-b-2 border-transparent hover:border-rose-600">About Us</a>
          <a href="/contact" class="hover:text-rose-600 transition-colors pb-1 border-b-2 border-transparent hover:border-rose-600">Contact</a>
        </div>

        <!-- Right Section: Button -->
        <div class="flex justify-end items-center gap-4">
          <a href="<%= airbnbUrl %>" target="_blank" 
             class="hidden md:inline-flex bg-rose-600 hover:bg-rose-700 text-white px-7 py-2.5 rounded-full text-sm font-semibold tracking-wide uppercase transition-all shadow-sm hover:shadow-rose-200 hover:-translate-y-0.5 transform duration-200">
            Book on Airbnb →
          </a>

          <button id="mobile-menu-button" class="md:hidden text-2xl text-gray-800 p-1 focus:outline-none">
            <i class="fa-solid fa-bars"></i>
          </button>
        </div>
      </div>

      <!-- Mobile Menu -->
      <div id="mobile-menu" class="hidden md:hidden mt-4 py-4 border-t border-gray-100">
        <div class="flex flex-col space-y-4 text-center font-medium tracking-wider uppercase">
          <a href="/" class="text-gray-700 hover:text-rose-600 py-2">Home</a>
          <a href="/rooms" class="text-rose-600 py-2">Rooms & Suites</a>
          <a href="/about" class="text-gray-700 hover:text-rose-600 py-2">About Us</a>
          <a href="/contact" class="text-gray-700 hover:text-rose-600 py-2">Contact</a>
          <a href="<%= airbnbUrl %>" target="_blank" class="mt-4 bg-rose-600 text-white py-3.5 rounded-xl block text-sm font-bold shadow-md">
            Book on Airbnb →
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Header Banner -->
  <header class="py-16 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-6 text-center space-y-3">
      <span class="text-rose-600 uppercase tracking-widest font-semibold text-sm">Our Accommodations</span>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900">Rooms & Suites</h1>
      <div class="h-1 w-12 bg-rose-600 mx-auto rounded-full"></div>
    </div>
  </header>

  <!-- Rooms Cards Main Container -->
  <main class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">

      
      <!-- Card 1: Cozy Room -->
      <div class="bg-white rounded-3xl overflow-hidden shadow-sm border border-gray-100 group hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
        <div class="overflow-hidden h-72 relative">
          <img src="https://unsplash.com" 
               class="w-full h-full object-cover group-hover:scale-105 transition duration-500" alt="Cozy Room">
          <span class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm text-gray-900 text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full shadow-sm">
            Cozy Room
          </span>
        </div>
        <div class="p-8 space-y-6">
          <div class="space-y-2">
            <h3 class="text-2xl font-bold text-gray-900">Cozy Room</h3>
            <div class="flex flex-wrap items-center gap-y-2 text-gray-600 text-sm font-medium">
              <span class="inline-flex items-center"><i class="fa-solid fa-bed mr-2 text-rose-500"></i>King bed</span>
              <span class="mx-3 text-gray-300">•</span>
              <span class="inline-flex items-center"><i class="fa-solid fa-maximize mr-2 text-rose-500"></i>35 sqm</span>
              <span class="mx-3 text-gray-300">•</span>
              <span class="inline-flex items-center"><i class="fa-solid fa-mountain-sun mr-2 text-rose-500"></i>City View</span>
            </div>
          </div>
          
          <div class="flex items-baseline justify-between border-t border-gray-50 pt-4">
            <p class="text-3xl font-extrabold text-rose-600">₱3,500 <span class="text-sm font-normal text-gray-500 tracking-normal">/ night</span></p>
          </div>

          <a href="<%= airbnbUrl %>" target="_blank" 
             class="block text-center bg-rose-600 hover:bg-rose-700 text-white font-semibold uppercase tracking-wider text-sm py-4 rounded-xl transition-colors shadow-md hover:shadow-rose-100">
            Book on Airbnb
          </a>
        </div>
      </div>

      <!-- Card 2: Deluxe Room -->
      <div class="bg-white rounded-3xl overflow-hidden shadow-sm border border-gray-100 group hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
        <div class="overflow-hidden h-72 relative">
          <img src="https://unsplash.com" 
               class="w-full h-full object-cover group-hover:scale-105 transition duration-500" alt="Deluxe Room">
          <span class="absolute top-4 left-4 bg-gray-900/90 backdrop-blur-sm text-white text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full shadow-sm">
            Deluxe Room
          </span>
        </div>
        <div class="p-8 space-y-6">
          <div class="space-y-2">
            <h3 class="text-2xl font-bold text-gray-900">Deluxe Room</h3>
            <div class="flex flex-wrap items-center gap-y-2 text-gray-600 text-sm font-medium">
              <span class="inline-flex items-center"><i class="fa-solid fa-couch mr-2 text-rose-500"></i>Living area</span>
              <span class="mx-3 text-gray-300">•</span>
              <span class="inline-flex items-center"><i class="fa-solid fa-maximize mr-2 text-rose-500"></i>65 sqm</span>
              <span class="mx-3 text-gray-300">•</span>
              <span class="inline-flex items-center"><i class="fa-solid fa-cloud-sun mr-2 text-rose-500"></i>Balcony</span>
            </div>
          </div>
          
          <div class="flex items-baseline justify-between border-t border-gray-50 pt-4">
            <p class="text-3xl font-extrabold text-rose-600">₱6,800 <span class="text-sm font-normal text-gray-500 tracking-normal">/ night</span></p>
          </div>

          <a href="<%= airbnbUrl %>" target="_blank" 
             class="block text-center bg-rose-600 hover:bg-rose-700 text-white font-semibold uppercase tracking-wider text-sm py-4 rounded-xl transition-colors shadow-md hover:shadow-rose-100">
            Book on Airbnb
          </a>
        </div>
      </div>

      <!-- Card 3: Suite Room -->
      <div class="bg-white rounded-3xl overflow-hidden shadow-sm border border-gray-100 group hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
        <div class="overflow-hidden h-72 relative">
          <img src="https://unsplash.com" 
               class="w-full h-full object-cover group-hover:scale-105 transition duration-500" alt="Suite Room">
          <span class="absolute top-4 left-4 bg-gray-900/90 backdrop-blur-sm text-white text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full shadow-sm">
            Suite Room
          </span>
        </div>
        <div class="p-8 space-y-6">
          <div class="space-y-2">
            <h3 class="text-2xl font-bold text-gray-900">Suite Room</h3>
            <div class="flex flex-wrap items-center gap-y-2 text-gray-600 text-sm font-medium">
              <span class="inline-flex items-center"><i class="fa-solid fa-couch mr-2 text-rose-500"></i>Living area</span>
              <span class="mx-3 text-gray-300">•</span>
              <span class="inline-flex items-center"><i class="fa-solid fa-maximize mr-2 text-rose-500"></i>65 sqm</span>
              <span class="mx-3 text-gray-300">•</span>
              <span class="inline-flex items-center"><i class="fa-solid fa-cloud-sun mr-2 text-rose-500"></i>Balcony</span>
            </div>
          </div>
          
          <div class="flex items-baseline justify-between border-t border-gray-50 pt-4">
            <p class="text-3xl font-extrabold text-rose-600">₱6,800 <span class="text-sm font-normal text-gray-500 tracking-normal">/ night</span></p>
          </div>

          <a href="<%= airbnbUrl %>" target="_blank" 
             class="block text-center bg-rose-600 hover:bg-rose-700 text-white font-semibold uppercase tracking-wider text-sm py-4 rounded-xl transition-colors shadow-md hover:shadow-rose-100">
            Book on Airbnb
          </a>
        </div>
      </div>

    </div>
  </main>


  <script>
    // Mobile Menu Toggle
    const menuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    
    if (menuButton && mobileMenu) {
      menuButton.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
        const icon = menuButton.querySelector('i');
        icon.classList.toggle('fa-bars');
        icon.classList.toggle('fa-xmark');
      });
    }
  </script>
</body>
</html>
