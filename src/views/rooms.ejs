<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rooms & Suites - ANSADEIS</title>
  
  <link rel="stylesheet" href="/css/output.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body class="bg-gray-50 font-sans tracking-wide antialiased">

  <!-- Navbar (Matched perfectly with Home Section) -->
  <nav class="bg-white/95 backdrop-blur-md shadow-sm sticky top-0 z-50 border-b border-gray-100">
    <div class="max-w-360 mx-auto px-6 py-4">
      <div class="grid grid-cols-2 md:grid-cols-3 items-center">
        
        <!-- Left Section: Logo -->
        <div class="flex justify-start">
          <a href="/" class="flex items-center">
            <img src="https://diiqzqswkdivdyjvabpm.supabase.co/storage/v1/object/public/Room%20Images/IMG_0176.PNG" alt="ANSADEIS" class="h-10 md:h-12 w-auto object-contain">
          </a>
        </div>

        <!-- Middle Section: Centered Nav Links -->
        <div class="hidden md:flex justify-center space-x-10 text-base font-medium text-gray-700 tracking-wider uppercase">
          <a href="/" class="hover:text-rose-600 transition-colors pb-1 border-b-2 border-transparent hover:border-rose-600">Home</a>
          <a href="/rooms" class="text-rose-600 transition-colors border-b-2 border-rose-600 pb-1">Rooms & Suites</a>
          <a href="/about" class="hover:text-rose-600 transition-colors pb-1 border-b-2 border-transparent hover:border-rose-600">About Us</a>
          <a href="/contact" class="hover:text-rose-600 transition-colors pb-1 border-b-2 border-transparent hover:border-rose-600">Contact</a>
        </div>

        <!-- Right Section: Button -->
        <div class="flex justify-end items-center gap-4">
          <a href="<%= airbnbUrl %>" target="_blank" 
             class="hidden md:inline-flex bg-rose-600 hover:bg-rose-700 text-white px-7 py-2.5 rounded-full text-sm font-semibold tracking-wide uppercase transition-all shadow-sm hover:shadow-rose-200 hover:-translate-y-0.5 transform duration-200">
            Book on Airbnb →
          </a>

          <button id="mobile-menu-button" class="md:hidden text-2xl text-gray-800 p-1 focus:outline-none">
            <i class="fa-solid fa-bars"></i>
          </button>
        </div>
      </div>

      <!-- Mobile Menu -->
      <div id="mobile-menu" class="hidden md:hidden mt-4 py-4 border-t border-gray-100">
        <div class="flex flex-col space-y-4 text-center font-medium tracking-wider uppercase">
          <a href="/" class="text-gray-700 hover:text-rose-600 py-2">Home</a>
          <a href="/rooms" class="text-rose-600 py-2">Rooms & Suites</a>
          <a href="/about" class="text-gray-700 hover:text-rose-600 py-2">About Us</a>
          <a href="/contact" class="text-gray-700 hover:text-rose-600 py-2">Contact</a>
          <a href="<%= airbnbUrl %>" target="_blank" class="mt-4 bg-rose-600 text-white py-3.5 rounded-xl block text-sm font-bold shadow-md">
            Book on Airbnb →
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Header Banner -->
  <header class="py-16 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-6 text-center space-y-3">
      <span class="text-rose-600 uppercase tracking-widest font-semibold text-sm">Our Accommodations</span>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900">Rooms & Suites</h1>
      <div class="h-1 w-12 bg-rose-600 mx-auto rounded-full"></div>
    </div>
  </header>

    <!-- Rooms Cards Main Container -->
  <main class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10 items-start">

      <% if (rooms && rooms.length > 0) { %>
        <% rooms.forEach(pkg => { %>

          <div class="bg-white rounded-3xl overflow-hidden shadow-sm border border-gray-100 group hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
            
            <!-- TOP CARD SECTION: Photos -->
            <div class="overflow-hidden h-72 relative bg-gray-100">
              <img src="<%= pkg.imageUrl %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" alt="<%= pkg.name %>">
              
              <!-- Left-Aligned: Category Package Badge -->
              <span class="absolute top-4 left-4 bg-gray-900/80 backdrop-blur-sm text-white text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full shadow-sm">
                <%= pkg.name %>
              </span>
            </div>
            
            <!-- BOTTOM CARD SECTION: Details Content Box -->
            <div class="p-8 space-y-6">
              <div class="space-y-2">
                <h3 class="text-2xl font-bold text-gray-900"><%= pkg.name %></h3>
                
                <div class="flex flex-wrap items-center gap-y-2 text-gray-600 text-sm font-medium">
                  <span class="inline-flex items-center"><i class="fa-solid fa-bed mr-2 text-rose-500"></i><%= pkg.bedType %></span>
                  <span class="mx-3 text-gray-400">•</span>
                  <span class="inline-flex items-center"><i class="fa-solid fa-cloud-sun mr-2 text-rose-500"></i><%= pkg.viewType || "Standard View" %></span>
                </div>
              </div>
              
              <div class="flex items-baseline justify-between border-t border-gray-50 pt-4">
                <p class="text-3xl font-extrabold text-rose-600">
                  ₱<%= pkg.price.toLocaleString() %> <span class="text-sm font-normal text-gray-500 tracking-normal">/ night</span>
                </p>
              </div>

              <!-- DYNAMIC UNIT SELECTION BOOKING FORM ACCORDION -->
              <div class="border-t border-gray-100 pt-4">
                
                <!--Pass a calculated list of ALL approved bookings for this package -->
                <% 
                  let allBlockedRanges = [];
                  pkg.units.forEach(unit => {
                    if (unit.blockedDates) {
                      allBlockedRanges.push({
                        unitId: unit.id,
                        dates: unit.blockedDates
                      });
                    }
                  });
                %>
                
                <details name="room-accordion" 
                         class="group border border-gray-200 rounded-2xl bg-gray-50/50 overflow-hidden [&_summary::-webkit-details-marker]:hidden"
                         data-package-bookings='<%= JSON.stringify(allBlockedRanges) %>'
                         data-total-units="<%= pkg.units.length %>">
                  
                  <summary class="flex items-center justify-between px-4 py-3 cursor-pointer hover:bg-gray-50 transition-colors">
                    <span class="text-xs font-bold text-gray-800 tracking-wide uppercase">Reserve Your Stay Here</span>
                    <span class="transition duration-300 group-open:-rotate-180 text-rose-600 text-xs">▼</span>
                  </summary>

                  <!-- The form submission target URL is handled dynamically via Javascript below -->
                  <form method="POST" id="form-<%= pkg.name.replace(/\s+/g, '-') %>" onsubmit="this.action='/rooms/' + this.roomId.value + '/book';" class="p-4 bg-white border-t border-gray-200 space-y-4">
                    
                    <!--  OPTION WRAPPER -->
                    <div class="space-y-1 relative">
                      <label class="text-[10px] font-black uppercase tracking-widest text-gray-500">Select Available Unit</label>
                      <select name="roomId" required class="room-unit-selector w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2.5 text-xs font-bold focus:outline-none focus:border-rose-500 focus:bg-white transition-all">
                        <option value="" disabled selected>-- Choose a room unit --</option>
                        <% let dynamicAvailableCount = 0; %>
                        <% pkg.units.forEach(unit => { dynamicAvailableCount++; %>
                          
                          <!--  Pulls the precise database property variable from Step 1 directly with NO fallback constraints -->
                          <option value="<%= unit.id %>" data-num="<%= unit.roomNumber %>" data-max="<%= unit.maxGuests %>" data-blocked='<%= JSON.stringify(unit.blockedDates || []) %>'>
                            <%= unit.roomNumber %> (Available) - Max <%= unit.maxGuests %> PAX
                          </option>
                          
                        <% }); %>
                      </select>
                    </div>





                    <div class="grid grid-cols-2 gap-3">
                      <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase tracking-widest text-gray-500">Check-In</label>
                        <input type="date" name="checkIn" required class="w-full bg-gray-50 border border-gray-200 rounded-xl px-2.5 py-1.5 text-xs focus:outline-none focus:border-rose-500">
                      </div>
                      <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase tracking-widest text-gray-500">Check-Out</label>
                        <input type="date" name="checkOut" required class="w-full bg-gray-50 border border-gray-200 rounded-xl px-2.5 py-1.5 text-xs focus:outline-none focus:border-rose-500">
                      </div>
                    </div>

                    <!-- COMPREHENSIVE BUILT-IN BOOKING ACCORDION FORM -->
                    <div class="space-y-1">
                      <label class="text-[10px] font-black uppercase tracking-widest text-gray-500">Full Name</label>
                      <input type="text" name="guestName" required placeholder="Juana Dela Cruz" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-xs focus:outline-none focus:border-rose-500">
                    </div>

                    <div class="grid grid-cols-3 gap-2"> <!-- Changed to grid-cols-3 to fit the extra field cleanly -->
                      <div class="space-y-1 col-span-1">
                        <label class="text-[10px] font-black uppercase tracking-widest text-gray-500">No. of Guests</label>
                        <input type="number" name="numberOfGuests" required min="1" value="1" class="guest-count-input w-full bg-gray-50 border border-gray-200 rounded-xl px-2 py-2 text-xs font-bold focus:outline-none focus:border-rose-500 text-center">
                      </div>
                      <div class="space-y-1 col-span-2">
                        <label class="text-[10px] font-black uppercase tracking-widest text-gray-500">Mobile Phone</label>
                        <input type="tel" name="guestPhone" required placeholder="09123456789" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-xs focus:outline-none focus:border-rose-500">
                      </div>
                    </div>

                    <div class="space-y-1">
                      <label class="text-[10px] font-black uppercase tracking-widest text-gray-500">Email Address</label>
                      <input type="email" name="guestEmail" required placeholder="juana@example.com" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-xs focus:outline-none focus:border-rose-500">
                    </div>


                    <!-- Deactivates block completely if all units under this package tier are full -->
                    <button type="submit" 
                            <%= dynamicAvailableCount === 0 ? 'disabled' : '' %>
                            class="w-full text-center bg-rose-600 hover:bg-rose-700 disabled:bg-gray-300 disabled:cursor-not-allowed text-white font-bold uppercase tracking-wider text-[11px] py-3 rounded-xl transition-all shadow-md">
                      <%= dynamicAvailableCount > 0 ? ' Reserve ' : 'Fully Booked / Unavailable' %>
                    </button>
                  </form>
                </details>
              </div>

            </div>
          </div>

        <% }); %>
      <% } else { %>
        <div class="col-span-full text-center py-12">
          <p class="text-gray-500 text-lg font-medium">No accommodations found.</p>
        </div>
      <% } %>

    </div>
  </main>




  <script>
    // Mobile Menu Toggle
    const menuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const guestInput = form.querySelector('.guest-count-input');
    const selectedOption = unitSelector.options[unitSelector.selectedIndex];

    if (selectedOption && selectedOption.value && guestInput) {
        const allowedMaxCapacity = parseInt(selectedOption.dataset.max, 10) || 4;
        const currentTypedCount = parseInt(guestInput.value, 10) || 1;
        
        if (currentTypedCount > allowedMaxCapacity) {
          // FIXED: Uses dynamic variable text interpolation to show the exact database limit
          alert("Occupancy threshold exceeded! The selected room tracking unit only features a maximum capacity limit constraint of " + allowedMaxCapacity + " PAX.");
          guestInput.value = allowedMaxCapacity;
          return;
        }

      }

    if (menuButton && mobileMenu) {
      menuButton.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
        const icon = menuButton.querySelector('i');
        icon.classList.toggle('fa-bars');
        icon.classList.toggle('fa-xmark');
      });
    }
  </script>

    <!-- REAL-TIME CALENDAR CALCULATION & OVERLAP PROTECTION INTERCEPTOR -->
  <script>
    document.addEventListener('change', function(event) {
      const targetInput = event.target;
      if (targetInput.name !== 'checkIn' && targetInput.name !== 'checkOut' && !targetInput.classList.contains('room-unit-selector') && !targetInput.classList.contains('guest-count-input')) return;

      const form = targetInput.closest('form');
      const accordion = targetInput.closest('details');
      if (!form || !accordion) return;

      const checkInInput = form.querySelector('input[name="checkIn"]');
      const checkOutInput = form.querySelector('input[name="checkOut"]');
      const unitSelector = form.querySelector('.room-unit-selector');
      const guestInput = form.querySelector('.guest-count-input');
      const submitBtn = form.querySelector('button[type="submit"]');

      if (!checkInInput || !checkOutInput || !unitSelector || !guestInput) return;

      // 🛡️ SECURITY LAYER 1: STRICT LOCALIZED PASSENGER CAPACITY ENFORCEMENT
      const selectedOption = unitSelector.options[unitSelector.selectedIndex];
      if (selectedOption && selectedOption.value) {
        const allowedMaxCapacity = parseInt(selectedOption.dataset.max, 10);
        const currentTypedCount = parseInt(guestInput.value, 10) || 1;
        
        if (currentTypedCount > allowedMaxCapacity) {
          alert("⚠️ Occupancy threshold exceeded! This room unit tracking asset only features a maximum capacity limit constraint of " + allowedMaxCapacity + " PAX.");
          guestInput.value = allowedMaxCapacity;
          return;
        }
      }

      const userIn = checkInInput.value;
      const userOut = checkOutInput.value;

      if (!userIn || !userOut) return;

      // 🛡️ TIMECODE UNIFICATION MATRIX: Normalize date picker values to local midnight milliseconds
      const userInDate = new Date(userIn + 'T00:00:00').getTime();
      const userOutDate = new Date(userOut + 'T00:00:00').getTime();

      if (userOutDate <= userInDate) {
        alert("Check-Out date must be after your Check-In date!");
        checkOutInput.value = "";
        return;
      }

      let totalValidAvailableOptions = 0;
      const totalUnitsInPackage = parseInt(accordion.dataset.totalUnits || '1', 10);

      // 🛡️ COMBINED SECURITY LAYER 2 & 3: SINGLE PASS VALIDATION MATRIX
      Array.from(unitSelector.options).forEach(option => {
        if (!option.value) return; // Skip placeholder text option

        const cleanNum = option.dataset.num || "Room";
        const maxCap = parseInt(option.dataset.max, 10) || 2;
        const blockedRangesRaw = option.dataset.blocked;
        if (!blockedRangesRaw) return;

        const blockedRanges = JSON.parse(blockedRangesRaw);
        let isUnitBooked = false;

        blockedRanges.forEach(range => {
          // Clean Fix: Extract purely the date string elements to bypass UTC/GMT hour shifts entirely
          const existingInRaw = range.start.toString().split('T')[0];
          const existingOutRaw = range.end.toString().split('T')[0];

          const bookedInTime = new Date(existingInRaw + 'T00:00:00').getTime();
          const bookedOutTime = new Date(existingOutRaw + 'T00:00:00').getTime();

          // Standard SQL Overlap Lock Equation: (StartA < EndB) AND (EndA > StartB)
          if (userInDate < bookedOutTime && userOutDate > bookedInTime) {
            isUnitBooked = true;
          }
        });

        if (isUnitBooked) {
          option.disabled = true;
          option.text = cleanNum + " (Fully Booked for These Dates)";
          
          // Force choice reset if the user previously selected this now-blocked unit
          if (unitSelector.value === option.value) {
            unitSelector.value = "";
          }
        } else {
          option.disabled = false;
          option.text = cleanNum + " (Available) - Max " + maxCap + " PAX";
          totalValidAvailableOptions++;
        }
      });

      // 🛡️ FINAL SUBMIT SHIELD ENFORCEMENT
      if (totalValidAvailableOptions === 0) {
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerText = "No Units Available For These Dates";
        }
      } else {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerText = "Submit Reservation Request";
        }
      }
    });

    // Enforce HTML Calendar minimum bounds dynamically to block past date checkouts
    document.querySelectorAll('input[type="date"]').forEach(input => {
      input.min = new Date().toISOString().split('T')[0];
    });
  </script>

  


</body>
</html>
